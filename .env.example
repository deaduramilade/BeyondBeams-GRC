DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-random-32-character-secret"
AUTH_URL="http://localhost:3000"
# Local development always uses database-backed email previews and needs no credentials.
EMAIL_PROVIDER="preview"
# Production: EMAIL_PROVIDER="resend", RESEND_API_KEY and a verified EMAIL_FROM.
# RESEND_API_KEY=""
# EMAIL_FROM="BeyondBeams GRC <notifications@example.com>"
# Protect the review-reminder cron endpoint in shared environments.
# NOTIFICATION_CRON_SECRET=""
# Optional local seed login password. Keep this only in your untracked .env file.
# SEED_DEMO_PASSWORD=""