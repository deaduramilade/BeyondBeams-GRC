generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  RISK_MANAGER
  ASSESSOR
  VIEWER
  AUDITOR
}

enum RiskTreatment {
  ACCEPT
  MITIGATE
  TRANSFER
  AVOID
  NONE
}

enum RiskStatus {
  DRAFT
  OPEN
  IN_REVIEW
  TREATMENT
  IN_MONITORING
  ACCEPTED
  CLOSED
  ARCHIVED
}

enum ReviewOutcome {
  CONTINUE
  REASSESS
  CLOSE
  ESCALATE
}

enum ControlTestResult {
  NOT_TESTED
  PASS
  PARTIAL
  FAIL
}

enum RiskCategory {
  CYBERSECURITY
  COMPLIANCE
  OPERATIONAL
  STRATEGIC
  FINANCIAL
  PEOPLE
  THIRD_PARTY
  RESILIENCE
  PRIVACY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum Plan {
  FREE
  BASIC
  PROFESSIONAL
  PREMIUM
}

enum ReportType {
  RISK_REGISTER
  BOARD_REPORT
  GAP_ANALYSIS
  AUDIT_TRAIL
}

enum ExportFormat {
  CSV
  XLSX
  PDF
}

enum ExportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AssessmentType {
  INHERENT
  RESIDUAL
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum TreatmentActionStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ControlEffectiveness {
  NOT_ASSESSED
  INEFFECTIVE
  PARTIALLY_EFFECTIVE
  EFFECTIVE
}

enum EvidenceStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum AppetiteBreachStatus {
  OPEN
  ACKNOWLEDGED
  TREATING
  ACCEPTED
  RESOLVED
}

enum TaxonomyType {
  RISK_CATEGORY
  BUSINESS_UNIT
  OBJECTIVE
  RISK_SOURCE
  REGULATORY_DOMAIN
  TAG
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobType {
  REPORT_EXPORT
  NOTIFICATION_DELIVERY
  REVIEW_REMINDER
}

enum ReassessmentStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Tenant {
  id                     String                   @id @default(cuid())
  name                   String
  slug                   String                   @unique
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  users                  User[]
  memberships            Membership[]
  risks                  Risk[]
  auditEvents            AuditEvent[]
  grcRecords             GrcRecord[]
  complianceReferences   ComplianceReference[]
  emergingRisks          EmergingRisk[]
  plan                   Plan                     @default(FREE)
  exports                ExportHistory[]
  savedReports           SavedReport[]
  frameworkSelections    TenantFramework[]
  reviewRemindersEnabled Boolean                  @default(true)
  reviewReminderCadence  String                   @default("7,1,0")
  notifications          Notification[]
  sequences              TenantSequence[]
  assessments            Assessment[]
  treatmentPlans         TreatmentPlan[]
  treatmentActions       TreatmentAction[]
  controlProfiles        ControlProfile[]
  evidence               Evidence[]
  appetiteStatements     AppetiteStatement[]
  appetiteBreaches       AppetiteBreach[]
  taxonomyItems          TaxonomyItem[]
  reviews                RiskReview[]
  treatmentActionHistory TreatmentActionHistory[]
  controlTests           ControlTest[]
  scoringPolicies        ScoringPolicy[]
  jobs                   Job[]
  reviewSchedules        ReviewSchedule[]
  reassessmentRequests   ReassessmentRequest[]
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model TenantSequence {
  id       String @id @default(cuid())
  tenantId String
  name     String
  value    Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model User {
  id                            String                   @id @default(cuid())
  tenantId                      String
  email                         String                   @unique
  name                          String
  passwordHash                  String
  emailVerified                 DateTime?
  image                         String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  tenant                        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships                   Membership[]
  ownedRisks                    Risk[]                   @relation("RiskOwner")
  ownedEmergingRisks            EmergingRisk[]           @relation("EmergingRiskOwner")
  auditEvents                   AuditEvent[]             @relation("AuditActor")
  accounts                      Account[]
  sessions                      Session[]
  translatorUses                Int                      @default(0)
  paidPlan                      Boolean                  @default(false)
  generatedExports              ExportHistory[]
  savedReports                  SavedReport[]
  riskMappings                  RiskFrameworkMapping[]
  reviewedFrameworkMappings     RiskFrameworkMapping[]   @relation("FrameworkMappingReviewer")
  reviewEmailsEnabled           Boolean                  @default(true)
  assignmentEmailsEnabled       Boolean                  @default(true)
  exportEmailsEnabled           Boolean                  @default(true)
  sessionVersion                Int                      @default(0)
  mfaSecret                     String?
  mfaEnabled                    Boolean                  @default(false)
  mfaConfirmedAt                DateTime?
  securityOnboardingCompletedAt DateTime?
  notifications                 Notification[]
  authoredAssessments           Assessment[]             @relation("AssessmentAuthor")
  decidedAssessments            Assessment[]             @relation("AssessmentDecision")
  approvalDecisions             ApprovalDecision[]       @relation("ApprovalDecider")
  createdTreatmentPlans         TreatmentPlan[]          @relation("TreatmentPlanCreator")
  ownedTreatmentActions         TreatmentAction[]        @relation("TreatmentActionOwner")
  ownedControls                 ControlProfile[]         @relation("ControlOwner")
  uploadedEvidence              Evidence[]               @relation("EvidenceUploader")
  appetiteBreaches              AppetiteBreach[]         @relation("BreachOwner")
  reviews                       RiskReview[]             @relation("RiskReviewer")
  treatmentActionHistory        TreatmentActionHistory[] @relation("TreatmentActionHistoryActor")
  controlTests                  ControlTest[]            @relation("ControlTester")
  scoringPolicies               ScoringPolicy[]          @relation("ScoringPolicyCreator")
  createdReviewSchedules        ReviewSchedule[]         @relation("ReviewScheduleCreator")
  requestedReassessments        ReassessmentRequest[]    @relation("ReassessmentRequester")
  assignedReassessments         ReassessmentRequest[]    @relation("ReassessmentAssignee")
  decidedReassessments          ReassessmentRequest[]    @relation("ReassessmentDecider")

  @@index([tenantId])
  @@index([tenantId, email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String?
  inviteEmail   String?
  inviteToken   String?   @unique
  inviteExpires DateTime?
  invitedById   String?
  acceptedAt    DateTime?
  role          Role      @default(VIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@unique([tenantId, inviteEmail])
  @@index([tenantId])
  @@index([userId])
  @@index([inviteEmail])
}

model Risk {
  id                 String                 @id @default(cuid())
  tenantId           String
  reference          String
  title              String
  description        String
  category           RiskCategory
  businessUnitId     String?
  objectiveId        String?
  riskSourceId       String?
  regulatoryDomainId String?
  ownerId            String
  inherentLikelihood Int
  inherentImpact     Int
  inherentScore      Int
  residualLikelihood Int?
  residualImpact     Int?
  residualScore      Int?
  treatment          RiskTreatment          @default(NONE)
  status             RiskStatus             @default(OPEN)
  nextReviewDate     DateTime
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  version            Int                    @default(1)
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner              User                   @relation("RiskOwner", fields: [ownerId], references: [id])
  businessUnit       TaxonomyItem?          @relation("RiskBusinessUnit", fields: [businessUnitId], references: [id], onDelete: SetNull)
  objective          TaxonomyItem?          @relation("RiskObjective", fields: [objectiveId], references: [id], onDelete: SetNull)
  riskSource         TaxonomyItem?          @relation("RiskSource", fields: [riskSourceId], references: [id], onDelete: SetNull)
  regulatoryDomain   TaxonomyItem?          @relation("RiskRegulatoryDomain", fields: [regulatoryDomainId], references: [id], onDelete: SetNull)
  auditEvents        AuditEvent[]
  complianceLinks    RiskComplianceLink[]
  emergingSource     EmergingRisk?          @relation("PromotedRisk")
  frameworkMappings  RiskFrameworkMapping[]
  assessments        Assessment[]
  treatmentPlans     TreatmentPlan[]
  appetiteBreaches   AppetiteBreach[]
  reviews            RiskReview[]
  evidence           Evidence[]
  reviewSchedules    ReviewSchedule[]
  reassessmentRequests ReassessmentRequest[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, residualScore])
  @@index([ownerId])
}

model ReviewSchedule {
  id            String    @id @default(cuid())
  tenantId      String
  riskId        String    @unique
  cadenceMonths Int       @default(3)
  nextDueAt     DateTime
  active        Boolean   @default(true)
  createdById   String
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  risk          Risk      @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdBy     User      @relation("ReviewScheduleCreator", fields: [createdById], references: [id])

  @@index([tenantId, active, nextDueAt])
}

model ReassessmentRequest {
  id            String             @id @default(cuid())
  tenantId      String
  riskId        String
  requestedById String
  reason        String             @db.Text
  status        ReassessmentStatus @default(OPEN)
  assignedToId  String?
  notes         String?            @db.Text
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  risk          Risk               @relation(fields: [riskId], references: [id], onDelete: Cascade)
  requestedBy   User               @relation("ReassessmentRequester", fields: [requestedById], references: [id])
  assignedTo    User?              @relation("ReassessmentAssignee", fields: [assignedToId], references: [id])
  decidedBy     User?              @relation("ReassessmentDecider", fields: [decidedById], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, riskId])
}

model Job {
  id          String    @id @default(cuid())
  tenantId    String
  type        JobType
  status      JobStatus @default(QUEUED)
  payloadJson String    @db.Text
  resultJson  String?   @db.Text
  error       String?   @db.Text
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, runAfter])
  @@index([status, runAfter])
}

model Framework {
  id               String             @id @default(cuid())
  name             String             @unique
  version          String
  description      String             @db.Text
  industryTags     String
  sourceUrl        String?
  publicationDate  DateTime?
  lastReviewedAt   DateTime?
  contentOwner     String?
  applicability    String?            @db.Text
  controls         FrameworkControl[]
  tenantSelections TenantFramework[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([name])
}

model Assessment {
  id             String           @id @default(cuid())
  tenantId       String
  riskId         String
  type           AssessmentType
  revision       Int
  likelihood     Int
  impact         Int
  score          Int
  rationale      String           @db.Text
  status         AssessmentStatus @default(DRAFT)
  authorId       String
  submittedAt    DateTime?
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  risk           Risk             @relation(fields: [riskId], references: [id], onDelete: Cascade)
  author         User             @relation("AssessmentAuthor", fields: [authorId], references: [id])
  decidedBy      User?            @relation("AssessmentDecision", fields: [decidedById], references: [id])

  @@unique([riskId, type, revision])
  @@index([tenantId, riskId, status])
}

model RiskReview {
  id                    String         @id @default(cuid())
  tenantId              String
  riskId                String
  reviewerId            String
  scheduledFor          DateTime
  completedAt           DateTime?
  outcome               ReviewOutcome?
  notes                 String?        @db.Text
  reassessmentRequested Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  risk                  Risk           @relation(fields: [riskId], references: [id], onDelete: Cascade)
  reviewer              User           @relation("RiskReviewer", fields: [reviewerId], references: [id])

  @@index([tenantId, scheduledFor])
  @@index([tenantId, riskId, completedAt])
}

model TreatmentPlan {
  id          String             @id @default(cuid())
  tenantId    String
  riskId      String
  strategy    RiskTreatment
  summary     String             @db.Text
  targetDate  DateTime
  status      ApprovalStatus     @default(PENDING)
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  risk        Risk               @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("TreatmentPlanCreator", fields: [createdById], references: [id])
  approvals   ApprovalDecision[]
  actions     TreatmentAction[]
  evidence    Evidence[]

  @@index([tenantId, riskId, status])
}

model ApprovalDecision {
  id              String         @id @default(cuid())
  treatmentPlanId String
  kind            String
  status          ApprovalStatus
  rationale       String         @db.Text
  decidedById     String
  decidedAt       DateTime       @default(now())
  treatmentPlan   TreatmentPlan  @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  decidedBy       User           @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([treatmentPlanId, kind, decidedAt])
}

model TreatmentAction {
  id              String                   @id @default(cuid())
  tenantId        String
  treatmentPlanId String
  title           String
  description     String                   @db.Text
  ownerId         String
  status          TreatmentActionStatus    @default(NOT_STARTED)
  priority        String                   @default("MEDIUM")
  dueDate         DateTime
  completedAt     DateTime?
  escalatedAt     DateTime?
  escalationLevel Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treatmentPlan   TreatmentPlan            @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  owner           User                     @relation("TreatmentActionOwner", fields: [ownerId], references: [id])
  evidence        Evidence[]
  history         TreatmentActionHistory[]

  @@index([tenantId, ownerId, status, dueDate])
}

model TreatmentActionHistory {
  id                String                 @id @default(cuid())
  tenantId          String
  treatmentActionId String
  actorId           String
  fromStatus        TreatmentActionStatus?
  toStatus          TreatmentActionStatus
  note              String?                @db.Text
  createdAt         DateTime               @default(now())
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  treatmentAction   TreatmentAction        @relation(fields: [treatmentActionId], references: [id], onDelete: Cascade)
  actor             User                   @relation("TreatmentActionHistoryActor", fields: [actorId], references: [id])

  @@index([tenantId, treatmentActionId, createdAt])
}

model ControlProfile {
  id                   String               @id @default(cuid())
  tenantId             String
  frameworkControlId   String
  ownerId              String?
  implementationStatus String               @default("NOT_STARTED")
  effectiveness        ControlEffectiveness @default(NOT_ASSESSED)
  frequency            String?
  lastTestedAt         DateTime?
  nextTestDate         DateTime?
  notes                String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  frameworkControl     FrameworkControl     @relation(fields: [frameworkControlId], references: [id], onDelete: Cascade)
  owner                User?                @relation("ControlOwner", fields: [ownerId], references: [id])
  evidence             Evidence[]
  tests                ControlTest[]

  @@unique([tenantId, frameworkControlId])
  @@index([tenantId, ownerId, effectiveness])
}

model ControlTest {
  id               String            @id @default(cuid())
  tenantId         String
  controlProfileId String
  testDate         DateTime
  result           ControlTestResult
  testerId         String
  notes            String?           @db.Text
  evidenceId       String?
  createdAt        DateTime          @default(now())
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  controlProfile   ControlProfile    @relation(fields: [controlProfileId], references: [id], onDelete: Cascade)
  tester           User              @relation("ControlTester", fields: [testerId], references: [id])
  evidence         Evidence?         @relation("ControlTestEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([tenantId, controlProfileId, testDate])
}

model ScoringPolicy {
  id          String   @id @default(cuid())
  tenantId    String
  version     Int
  effectiveAt DateTime
  bandsJson   String   @db.Text
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("ScoringPolicyCreator", fields: [createdById], references: [id])

  @@unique([tenantId, version])
  @@index([tenantId, active, effectiveAt])
}

model Evidence {
  id                String           @id @default(cuid())
  tenantId          String
  title             String
  description       String?          @db.Text
  storageKey        String?
  fileName          String?
  mimeType          String?
  sizeBytes         Int?
  checksum          String?
  status            EvidenceStatus   @default(DRAFT)
  validFrom         DateTime?
  expiresAt         DateTime?
  uploadedById      String
  treatmentPlanId   String?
  treatmentActionId String?
  controlProfileId  String?
  riskId            String?
  accessLevel       String           @default("WORKSPACE")
  retentionUntil    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy        User             @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  treatmentPlan     TreatmentPlan?   @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  treatmentAction   TreatmentAction? @relation(fields: [treatmentActionId], references: [id], onDelete: SetNull)
  controlProfile    ControlProfile?  @relation(fields: [controlProfileId], references: [id], onDelete: SetNull)
  risk              Risk?            @relation(fields: [riskId], references: [id], onDelete: SetNull)
  controlTests      ControlTest[]    @relation("ControlTestEvidence")

  @@index([tenantId, status, expiresAt])
}

model AppetiteStatement {
  id             String           @id @default(cuid())
  tenantId       String
  name           String
  category       RiskCategory?
  taxonomyItemId String?
  maximumScore   Int
  rationale      String           @db.Text
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxonomyItem   TaxonomyItem?    @relation(fields: [taxonomyItemId], references: [id], onDelete: SetNull)
  breaches       AppetiteBreach[]

  @@index([tenantId, active, category])
}

model AppetiteBreach {
  id                  String               @id @default(cuid())
  tenantId            String
  riskId              String
  appetiteStatementId String
  observedScore       Int
  status              AppetiteBreachStatus @default(OPEN)
  ownerId             String
  response            String?              @db.Text
  acknowledgedAt      DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  risk                Risk                 @relation(fields: [riskId], references: [id], onDelete: Cascade)
  appetiteStatement   AppetiteStatement    @relation(fields: [appetiteStatementId], references: [id], onDelete: Cascade)
  owner               User                 @relation("BreachOwner", fields: [ownerId], references: [id])

  @@unique([riskId, appetiteStatementId, status])
  @@index([tenantId, status, ownerId])
}

model TaxonomyItem {
  id                 String              @id @default(cuid())
  tenantId           String
  type               TaxonomyType
  name               String
  description        String?             @db.Text
  active             Boolean             @default(true)
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appetiteStatements AppetiteStatement[]
  businessUnitRisks  Risk[]              @relation("RiskBusinessUnit")
  objectiveRisks     Risk[]              @relation("RiskObjective")
  sourceRisks        Risk[]              @relation("RiskSource")
  regulatoryRisks    Risk[]              @relation("RiskRegulatoryDomain")

  @@unique([tenantId, type, name])
  @@index([tenantId, type, active, sortOrder])
}

model FrameworkControl {
  id              String                 @id @default(cuid())
  frameworkId     String
  controlId       String
  title           String
  description     String                 @db.Text
  category        String
  framework       Framework              @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  mappings        RiskFrameworkMapping[]
  controlProfiles ControlProfile[]

  @@unique([frameworkId, controlId])
  @@index([frameworkId])
  @@index([controlId])
  @@index([title])
}

model TenantFramework {
  id          String    @id @default(cuid())
  tenantId    String
  frameworkId String
  enabled     Boolean   @default(true)
  enabledAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  framework   Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([tenantId, frameworkId])
  @@index([tenantId, enabled])
}

model RiskFrameworkMapping {
  id                 String           @id @default(cuid())
  riskId             String
  frameworkControlId String
  mappedBy           String
  mappedAt           DateTime         @default(now())
  notes              String?          @db.Text
  applicability      String?          @db.Text
  reviewedAt         DateTime?
  reviewedById       String?
  risk               Risk             @relation(fields: [riskId], references: [id], onDelete: Cascade)
  frameworkControl   FrameworkControl @relation(fields: [frameworkControlId], references: [id], onDelete: Cascade)
  mapper             User             @relation(fields: [mappedBy], references: [id])
  reviewedBy         User?            @relation("FrameworkMappingReviewer", fields: [reviewedById], references: [id])

  @@unique([riskId, frameworkControlId])
  @@index([riskId])
  @@index([frameworkControlId])
  @@index([mappedBy])
}

model GrcRecord {
  id          String    @id @default(cuid())
  tenantId    String
  module      String
  title       String
  status      String
  owner       String
  dueDate     DateTime?
  priority    String
  details     String    @db.Text
  outcome     String    @db.Text
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, module])
}

model ComplianceReference {
  id           String               @id @default(cuid())
  tenantId     String
  framework    String
  jurisdiction String
  reference    String
  title        String
  excerpt      String               @db.Text
  metric       String?
  sourceUrl    String
  categories   String
  keywords     String
  industry     String
  createdAt    DateTime             @default(now())
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  riskLinks    RiskComplianceLink[]

  @@unique([tenantId, framework, reference])
  @@index([tenantId, framework])
}

model RiskComplianceLink {
  id          String              @id @default(cuid())
  riskId      String
  referenceId String
  rationale   String
  createdAt   DateTime            @default(now())
  risk        Risk                @relation(fields: [riskId], references: [id], onDelete: Cascade)
  reference   ComplianceReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([riskId, referenceId])
  @@index([riskId])
}

model EmergingRisk {
  id                 String    @id @default(cuid())
  tenantId           String
  title              String
  hypothesis         String    @db.Text
  indicators         String    @db.Text
  cadence            String
  horizon            String
  status             String    @default("MONITORING")
  ownerId            String
  nextReviewDate     DateTime
  settlementDecision String?   @db.Text
  settledAt          DateTime?
  promotedRiskId     String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner              User      @relation("EmergingRiskOwner", fields: [ownerId], references: [id])
  promotedRisk       Risk?     @relation("PromotedRisk", fields: [promotedRiskId], references: [id])

  @@index([tenantId, status])
}

model AuditEvent {
  id         String      @id @default(cuid())
  tenantId   String
  riskId     String?
  actorId    String
  requestId  String?
  source     String?
  ipAddress  String?
  userAgent  String?
  action     AuditAction
  entityType String      @default("Risk")
  entityId   String
  summary    String
  changes    Json?
  beforeJson String?
  afterJson  String?
  reason     String?
  createdAt  DateTime    @default(now())
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  risk       Risk?       @relation(fields: [riskId], references: [id], onDelete: SetNull)
  actor      User        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([tenantId, requestId])
  @@index([tenantId, entityId])
  @@index([riskId])
  @@index([actorId])
}

model ExportHistory {
  id                String       @id @default(cuid())
  tenantId          String
  generatedById     String
  reportType        ReportType
  format            ExportFormat
  fileName          String
  status            ExportStatus @default(PROCESSING)
  createdAt         DateTime     @default(now())
  completedAt       DateTime?
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generatedBy       User         @relation(fields: [generatedById], references: [id], onDelete: Cascade)
  artifactBase64    String?
  downloadTokenHash String?      @unique
  downloadExpires   DateTime?
  downloadedAt      DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([generatedById])
}

model Notification {
  id                String   @id @default(cuid())
  tenantId          String
  recipient         String
  type              String
  relatedEntityType String?
  relatedEntityId   String?
  subject           String
  htmlBody          String   @db.Text
  textBody          String   @db.Text
  status            String   @default("SENT")
  provider          String   @default("local-preview")
  dedupeKey         String?  @unique
  previewTokenHash  String?  @unique
  sentAt            DateTime @default(now())
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?

  @@index([tenantId, type, createdAt])
  @@index([tenantId, recipient])
  @@index([relatedEntityType, relatedEntityId])
}

model SavedReport {
  id                String       @id @default(cuid())
  tenantId          String
  createdById       String
  name              String
  reportType        ReportType
  format            ExportFormat
  configJson        Json         @default("{}")
  scheduleEnabled   Boolean      @default(false)
  scheduleFrequency String?
  recipientsJson    Json         @default("[]")
  nextRunAt         DateTime?
  lastRunAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy         User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, scheduleEnabled, nextRunAt])
  @@index([createdById])
}
