generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  RISK_MANAGER
  ASSESSOR
  VIEWER
  AUDITOR
}

enum RiskTreatment {
  ACCEPT
  MITIGATE
  TRANSFER
  AVOID
  NONE
}

enum RiskStatus {
  DRAFT
  OPEN
  IN_REVIEW
  TREATMENT
  IN_MONITORING
  ACCEPTED
  CLOSED
}

enum RiskCategory {
  CYBERSECURITY
  COMPLIANCE
  OPERATIONAL
  STRATEGIC
  FINANCIAL
  PEOPLE
  THIRD_PARTY
  RESILIENCE
  PRIVACY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum Plan {
  FREE
  BASIC
  PROFESSIONAL
  PREMIUM
}

enum ReportType {
  RISK_REGISTER
  BOARD_REPORT
  GAP_ANALYSIS
  AUDIT_TRAIL
}

enum ExportFormat {
  CSV
  XLSX
  PDF
}

enum ExportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Tenant {
  id                     String                @id @default(cuid())
  name                   String
  slug                   String                @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  users                  User[]
  memberships            Membership[]
  risks                  Risk[]
  auditEvents            AuditEvent[]
  grcRecords             GrcRecord[]
  complianceReferences   ComplianceReference[]
  emergingRisks          EmergingRisk[]
  plan                   Plan                  @default(FREE)
  exports                ExportHistory[]
  savedReports           SavedReport[]
  frameworkSelections    TenantFramework[]
  reviewRemindersEnabled Boolean               @default(true)
  reviewReminderCadence  String                @default("7,1,0")
  notifications          Notification[]
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model User {
  id                      String                 @id @default(cuid())
  tenantId                String
  email                   String                 @unique
  name                    String
  passwordHash            String
  emailVerified           DateTime?
  image                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships             Membership[]
  ownedRisks              Risk[]                 @relation("RiskOwner")
  ownedEmergingRisks EmergingRisk[] @relation("EmergingRiskOwner")
  auditEvents             AuditEvent[]           @relation("AuditActor")
  accounts                Account[]
  sessions                Session[]
  translatorUses          Int                    @default(0)
  paidPlan                Boolean                @default(false)
  generatedExports        ExportHistory[]
  savedReports            SavedReport[]
  riskMappings            RiskFrameworkMapping[]
  reviewEmailsEnabled     Boolean                @default(true)
  assignmentEmailsEnabled Boolean                @default(true)
  exportEmailsEnabled     Boolean                @default(true)
  notifications           Notification[]

  @@index([tenantId])
  @@index([tenantId, email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String?
  inviteEmail   String?
  inviteToken   String?   @unique
  inviteExpires DateTime?
  invitedById   String?
  acceptedAt    DateTime?
  role          Role      @default(VIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@unique([tenantId, inviteEmail])
  @@index([tenantId])
  @@index([userId])
  @@index([inviteEmail])
}

model Risk {
  id                 String                 @id @default(cuid())
  tenantId           String
  reference          String
  title              String
  description        String
  category           RiskCategory
  ownerId            String
  inherentLikelihood Int
  inherentImpact     Int
  inherentScore      Int
  residualLikelihood Int?
  residualImpact     Int?
  residualScore      Int?
  treatment          RiskTreatment          @default(NONE)
  status             RiskStatus             @default(OPEN)
  nextReviewDate     DateTime
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner              User                   @relation("RiskOwner", fields: [ownerId], references: [id])
  auditEvents        AuditEvent[]
  complianceLinks    RiskComplianceLink[]
  emergingSource     EmergingRisk?          @relation("PromotedRisk")
  frameworkMappings  RiskFrameworkMapping[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, residualScore])
  @@index([ownerId])
}

model Framework {
  id               String             @id @default(cuid())
  name             String             @unique
  version          String
  description      String
  industryTags     String
  controls         FrameworkControl[]
  tenantSelections TenantFramework[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([name])
}

model FrameworkControl {
  id          String                 @id @default(cuid())
  frameworkId String
  controlId   String
  title       String
  description String
  category    String
  framework   Framework              @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  mappings    RiskFrameworkMapping[]

  @@unique([frameworkId, controlId])
  @@index([frameworkId])
  @@index([controlId])
  @@index([title])
}

model TenantFramework {
  id          String    @id @default(cuid())
  tenantId    String
  frameworkId String
  enabled     Boolean   @default(true)
  enabledAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  framework   Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([tenantId, frameworkId])
  @@index([tenantId, enabled])
}

model RiskFrameworkMapping {
  id                 String           @id @default(cuid())
  riskId             String
  frameworkControlId String
  mappedBy           String
  mappedAt           DateTime         @default(now())
  notes              String?
  risk               Risk             @relation(fields: [riskId], references: [id], onDelete: Cascade)
  frameworkControl   FrameworkControl @relation(fields: [frameworkControlId], references: [id], onDelete: Cascade)
  mapper             User             @relation(fields: [mappedBy], references: [id])

  @@unique([riskId, frameworkControlId])
  @@index([riskId])
  @@index([frameworkControlId])
  @@index([mappedBy])
}

model GrcRecord {
  id          String    @id @default(cuid())
  tenantId    String
  module      String
  title       String
  status      String
  owner       String
  dueDate     DateTime?
  priority    String
  details     String
  outcome     String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, module])
}

model ComplianceReference {
  id           String               @id @default(cuid())
  tenantId     String
  framework    String
  jurisdiction String
  reference    String
  title        String
  excerpt      String
  metric       String?
  sourceUrl    String
  categories   String
  keywords     String
  industry     String
  createdAt    DateTime             @default(now())
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  riskLinks    RiskComplianceLink[]

  @@unique([tenantId, framework, reference])
  @@index([tenantId, framework])
}

model RiskComplianceLink {
  id          String              @id @default(cuid())
  riskId      String
  referenceId String
  rationale   String
  createdAt   DateTime            @default(now())
  risk        Risk                @relation(fields: [riskId], references: [id], onDelete: Cascade)
  reference   ComplianceReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([riskId, referenceId])
  @@index([riskId])
}

model EmergingRisk {
  id                 String    @id @default(cuid())
  tenantId           String
  title              String
  hypothesis         String
  indicators         String
  cadence            String
  horizon            String
  status             String    @default("MONITORING")
  ownerId            String
  nextReviewDate     DateTime
  settlementDecision String?
  settledAt          DateTime?
  promotedRiskId     String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner              User      @relation("EmergingRiskOwner", fields: [ownerId], references: [id])
  promotedRisk       Risk?     @relation("PromotedRisk", fields: [promotedRiskId], references: [id])

  @@index([tenantId, status])
}

model AuditEvent {
  id         String      @id @default(cuid())
  tenantId   String
  riskId     String?
  actorId    String
  action     AuditAction
  entityType String      @default("Risk")
  entityId   String
  summary    String
  changes    String?
  createdAt  DateTime    @default(now())
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  risk       Risk?       @relation(fields: [riskId], references: [id], onDelete: SetNull)
  actor      User        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([tenantId, entityId])
  @@index([riskId])
  @@index([actorId])
}

model ExportHistory {
  id                String       @id @default(cuid())
  tenantId          String
  generatedById     String
  reportType        ReportType
  format            ExportFormat
  fileName          String
  status            ExportStatus @default(PROCESSING)
  createdAt         DateTime     @default(now())
  completedAt       DateTime?
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generatedBy       User         @relation(fields: [generatedById], references: [id], onDelete: Cascade)
  artifactBase64    String?
  downloadTokenHash String?      @unique
  downloadExpires   DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([generatedById])
}

model Notification {
  id                String   @id @default(cuid())
  tenantId          String
  recipient         String
  type              String
  relatedEntityType String?
  relatedEntityId   String?
  subject           String
  htmlBody          String
  textBody          String
  status            String   @default("SENT")
  provider          String   @default("local-preview")
  dedupeKey         String?  @unique
  previewTokenHash  String?  @unique
  sentAt            DateTime @default(now())
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?

  @@index([tenantId, type, createdAt])
  @@index([tenantId, recipient])
  @@index([relatedEntityType, relatedEntityId])
}

model SavedReport {
  id                String       @id @default(cuid())
  tenantId          String
  createdById       String
  name              String
  reportType        ReportType
  format            ExportFormat
  configJson        String       @default("{}")
  scheduleEnabled   Boolean      @default(false)
  scheduleFrequency String?
  recipientsJson    String       @default("[]")
  nextRunAt         DateTime?
  lastRunAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy         User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, scheduleEnabled, nextRunAt])
  @@index([createdById])
}
